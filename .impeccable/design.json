      "html": "<label class=\"ds-label\" for=\"ds-answer\">Câu trả lời</label><input class=\"ds-field\" id=\"ds-answer\" autocomplete=\"off\">",
      "css": ".ds-label{display:block;margin-bottom:11px;font:500 15px/1.7 var(--sans);color:var(--text)}.ds-field{font:400 14px/1.7 var(--sans);padding:11px 12px;border:1px solid #b5c1d2;border-radius:5px;background:#fff;color:var(--text);caret-color:var(--accent);max-width:100%}.ds-field:hover{border-color:#8b9dbc}.ds-field:focus-visible{outline:3px solid #638dff;outline-offset:4px}.ds-field:disabled{background:#f1f4f9;color:var(--text);opacity:1}"
