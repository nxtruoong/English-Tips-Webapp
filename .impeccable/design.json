      "html": "<nav class=\"ds-nav\" aria-label=\"Điều hướng\"><a href=\"#today\" aria-current=\"page\">Hôm nay</a><a href=\"#practice\">Luyện tập</a></nav>",
      "css": ".ds-nav{padding:18px;background:var(--nav);display:flex;flex-direction:column;gap:7px}.ds-nav a{font:400 13px/1.7 var(--sans);padding:12px 15px;border:1px solid transparent;border-radius:5px;color:#c4d0e2;text-decoration:none;min-height:48px;box-sizing:border-box}.ds-nav a:hover{background:#203149;color:#fff}.ds-nav a[aria-current]{background:#263e65;border-color:#355785;color:#fff}.ds-nav a:focus-visible{outline:3px solid #a4c3ff;outline-offset:4px}"
